# AI Arena — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# Claude API key — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key — platform.openai.com → API Keys
OPENAI_API_KEY=sk-your-key-here

# Google Gemini API key — aistudio.google.com → Get API key
GOOGLE_API_KEY=AIza-your-key-here

# Password gate for the web UI — choose any strong password
# If not set, the app runs with no authentication (anyone can use your API keys)
APP_PASSWORD=your-password-here

# Port the server listens on (default: 3000)
PORT=3000

# ── Scout Bot (Telegram) — OPTIONAL ──────────────────────────────────────
# Set both to enable the proactive Telegram scout agent. Without these,
# bot.js exits cleanly on startup and the ai-arena web server is unaffected.
#
# 1. Open Telegram, message @BotFather, /newbot, follow prompts. Save the
#    HTTP API token it gives you.
TELEGRAM_BOT_TOKEN=
# 2. Choose any string. The first chat that sends this exact passphrase to
#    your bot becomes the locked authorized chat. Treat it like a password.
TELEGRAM_PASSPHRASE=
# 3. (Optional) hour of day (UTC) for Mon+Thu scout fires. Default 9 UTC
#    = ~12pm Kyiv (summer DST) / 11am (winter). Set 7 for 10am Kyiv summer.
SCOUT_FIRE_HOUR_UTC=9
